# Database
# Neon PostgreSQL connection string (get from Neon dashboard)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/bettertomorrow?sslmode=require"

# JWT
JWT_SECRET="generate-with-openssl-rand-base64-32"
JWT_REFRESH_SECRET="generate-with-openssl-rand-base64-32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=10000
NODE_ENV=production

# Frontend
FRONTEND_URL="https://bettertomorrowschool.com"
BACKEND_URL="https://bettertomorrow-api.onrender.com"

# CORS
CORS_ORIGIN="https://bettertomorrowschool.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500

# School Info
SCHOOL_NAME="Better Tomorrow School"
SCHOOL_EMAIL="info@bettertomorrowschool.com"
SCHOOL_PHONE="+254725839099"

# Email (configure for production)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"

# WhatsApp
WHATSAPP_API_KEY=""
SCHOOL_WHATSAPP_NUMBER="+254725839099"

# Analytics
ANALYTICS_ID=""